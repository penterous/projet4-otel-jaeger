# ---------------------------------------------------------------------------
# Groupe 4 — OpenTelemetry + Jaeger : variables d'environnement
# ---------------------------------------------------------------------------
# NE PAS VERSIONNER LE FICHIER .env (il est ignoré par .gitignore).
# Utiliser : ./scripts/bootstrap.sh  pour générer des secrets aléatoires.
# Les valeurs ci-dessous sont des EXEMPLES intentionnellement non fonctionnels.
# ---------------------------------------------------------------------------

# Base de données (compte dédié, jamais postgres/postgres)
POSTGRES_DB=shopdb
POSTGRES_USER=shop_app
POSTGRES_PASSWORD=EXAMPLE_CHANGE_ME_9fK3pQ7sW2xR

# Application
ADMIN_PASSWORD=EXAMPLE_CHANGE_ME_Admin_7hT4nL
CHAOS_TOKEN=EXAMPLE_CHANGE_ME_Chaos_5vB8dF
OTEL_ENVIRONMENT=lab

# Reverse-proxy d'administration (Jaeger + Mailpit) — basic auth
AUTH_USER=admin
AUTH_PASSWORD=EXAMPLE_CHANGE_ME_Gateway_3xP9mZ

# Grafana (compte admin renommé, mot de passe fort)
GRAFANA_USER=observadmin
GRAFANA_PASSWORD=EXAMPLE_CHANGE_ME_Grafana_6nQ2wE

# Routage des alertes (adresses fixes dans config/alertmanager/alertmanager.yml)
ALERT_EMAIL=soc@monitoring.lab

# ---------------------------------------------------------------------------
# Ports HÔTE (tous liés à 127.0.0.1). Valeurs par défaut choisies pour ne pas
# entrer en conflit avec une autre stack de TP déjà démarrée sur la machine.
# Les ports internes au réseau Docker restent inchangés.
# ---------------------------------------------------------------------------
PORT_FRONTEND=18080
PORT_API=18000
PORT_GRAFANA=13000
PORT_JAEGER=18686
PORT_MAILPIT_UI=18025
PORT_MAILPIT_SMTP=11025
PORT_PROMETHEUS=19090
PORT_ALERTMANAGER=19093
PORT_OTLP_GRPC=14317
PORT_OTLP_HTTP=14318
PORT_COLLECTOR_METRICS=18889
